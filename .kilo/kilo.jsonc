{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [".claude/CLAUDE.md", ".agents/**/*.md"],
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": ""
      },
      "enabled": false
    },
    "sequentialthinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": false
    }
  },
  "permission": {
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "external_directory": "ask",
    "edit": "ask",
    "skill": {
      "*": "ask",
      "bmad-code-review": "allow"
    },
    "task": "ask"
  },
  "model": "litellm/bellosoft-medium",
  "disabled_providers": [],
  "provider": {
    "litellm": {
      "name": "LiteLLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://litellm.bellosoft.dev/v1"
      },
      "models": {
        "bellosoft-medium": {
          "name": "bellosoft-medium"
        },
        "bellosoft-complex": {
          "name": "bellosoft-complex"
        },
        "bellosoft-simple": {
          "name": "bellosoft-simple"
        },
        "bellosoft-reasoning": {
          "name": "bellosoft-reasoning",
          "reasoning": true
        }
      }
    }
  }
}