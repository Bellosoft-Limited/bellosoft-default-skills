{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [".agents/instructions/bellosoft-core.instructions.md"],
  "skills": {
    "paths": [".claude/skills"],
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": "",
      },
      "enabled": false,
    },
    "sequentialthinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking",
      ],
      "enabled": false,
    },
    "plane": {
      "type": "local",
      "command": ["npx", "mcp-remote@latest", "https://mcp.plane.so/http/mcp"],
      "enabled": true,
    },
  },
  "permission": {
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "external_directory": "ask",
    "edit": "ask",
    "skill": {
      "*": "allow",
    },
    "task": "allow",
  },
  "model": "litellm/bellosoft-medium",
  "disabled_providers": [],
  "provider": {
    "litellm": {
      "name": "LiteLLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://litellm.bellosoft.dev/v1",
      },
      "models": {
        "bellosoft-medium": { "name": "bellosoft-medium" },
        "bellosoft-complex": { "name": "bellosoft-complex" },
        "bellosoft-simple": { "name": "bellosoft-simple" },
        "bellosoft-reasoning": {
          "name": "bellosoft-reasoning",
          "reasoning": true,
        },
      },
    },
  },
}
