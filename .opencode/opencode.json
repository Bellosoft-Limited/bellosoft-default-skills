{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".claude/CLAUDE.md", ".agents/**/*.md"],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm.bellosoft.dev/v1"
      },
      "models": {
        "bellosoft-simple": {
          "name": "Bellosoft Simple Model"
        },
        "bellosoft-medium": {
          "name": "Bellosoft Medium Model"
        },
        "bellosoft-complex": {
          "name": "Bellosoft Complex Model"
        },
        "bellosoft-reasoning": {
          "name": "Bellosoft Reasoning Model"
        }
      }
    }
  },
  "mcp": {
    "plane": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.plane.so/http/mcp"
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ]
}