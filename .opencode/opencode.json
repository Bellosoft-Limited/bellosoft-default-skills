{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm.bellosoft.dev/v1"
      },
      "models": {
        "bellosoft-simple": {
          "name": "Bellosoft Simple Model"
        },
        "bellosoft-medium": {
          "name": "Bellosoft Medium Model"
        },
        "bellosoft-complex": {
          "name": "Bellosoft Complex Model"
        },
        "bellosoft-reasoning": {
          "name": "Bellosoft Reasoning Model"
        }
      }
    }
  },
  "mcp": {
    "plane": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.plane.so/http/mcp"
    }
  },
  "agent": {
    "architect": {
      "mode": "primary",
      "model": "litellm/bellosoft-complex",
      "prompt": "{file:../.claude/agents/architect.agent.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "code": {
      "mode": "primary",
      "model": "litellm/bellosoft-simple",
      "prompt": "{file:../.claude/agents/code.agent.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "pm": {
      "mode": "primary",
      "model": "litellm/bellosoft-complex",
      "prompt": "{file:../.claude/agents/pm.agent.md}",
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    },
    "review": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "litellm/bellosoft-medium",
      "prompt": "{file:../.claude/agents/review.agent.md}",
      "permission": {
        "edit": "deny"
      }
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ]  
}