{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["../.agents/instructions/bellosoft-core.instructions.md", "../.agents/core/*.md"],
  "provider": {
    "myprovider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm.bellosoft.dev/v1"
      },
      "models": {
        "bellosoft-simple": {
          "name": "Bellosoft Simple Model"
        },
        "bellosoft-medium": {
          "name": "Bellosoft Medium Model"
        },
        "bellosoft-complex": {
          "name": "Bellosoft Complex Model"
        },
        "bellosoft-reasoning": {
          "name": "Bellosoft Reasoning Model"
        }
      }
    }
  },
  "agent": {
    "architect": {
      "mode": "primary",
      "model": "bellosoft-complex",
      "prompt": "{file:../.claude/agents/architect.agent.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      }
    },
    "code": {
      "mode": "primary",
      "model": "bellosoft-simple",
      "prompt": "{file:../.claude/agents/code.agent.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "pm": {
      "mode": "primary",
      "model": "bellosoft-complex",
      "prompt": "{file:../.claude/agents/pm.agent.md}",
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    },
    "review": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "bellosoft-medium",
      "prompt": "{file:../.claude/agents/review.agent.md}",
      "permission": {
        "edit": "deny"
      }
    }
  }
}